# Copia este archivo: cp .env.example .env

# Neon (recomendado)
# En https://console.neon.tech → tu proyecto → Connect:
#   - "Pooled connection"  → DATABASE_URL
#   - "Direct connection"  → DIRECT_URL
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxx.sa-east-1.aws.neon.tech/neondb?sslmode=require"

# PostgreSQL local (alternativa)
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/autohunt"
# DIRECT_URL="postgresql://postgres:postgres@localhost:5432/autohunt"

PORT=3000
NODE_ENV=development

# Auth JWT (genera uno seguro: openssl rand -base64 32)
JWT_SECRET="change-me-to-a-long-random-secret"
JWT_EXPIRES_IN=7d

# Rate limiting (opcional)
# RATE_LIMIT_PUBLIC_WINDOW_MS=900000
# RATE_LIMIT_PUBLIC_MAX=100
# RATE_LIMIT_AUTH_WINDOW_MS=900000
# RATE_LIMIT_AUTH_MAX=10
